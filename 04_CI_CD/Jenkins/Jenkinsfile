pipeline {
    agent any

    environment {
        PYTHON = 'C:\\Users\\kinga\\AppData\\Local\\Programs\\Python\\Python312\\python.exe'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=========================================='
                echo 'Checkout Source Code'
                echo '=========================================='

                checkout scm
            }
        }

        stage('Environment Check') {
            steps {
                echo '=========================================='
                echo 'Environment Check'
                echo '=========================================='

                bat "\"%PYTHON%\" --version"
                bat "\"%PYTHON%\" -m pip --version"
            }
        }

        stage('Install Dependencies') {
            steps {
                echo '=========================================='
                echo 'Install Dependencies'
                echo '=========================================='

                bat "\"%PYTHON%\" -m pip install -r requirements.txt"
            }
        }

        stage('Install Playwright Browser') {
            steps {
                echo '=========================================='
                echo 'Install Playwright Browser'
                echo '=========================================='

                bat "\"%PYTHON%\" -m playwright install chromium"
            }
        }

        stage('Start Mock Server') {
            steps {
                echo '=========================================='
                echo 'Start Mock Server'
                echo '=========================================='

                bat "start \"Robot Mock Server\" /B \"%PYTHON%\" 02_API_Automation\\mock_server\\robot_api.py"

                echo 'Mock Server started'

                sleep time: 3, unit: 'SECONDS'
            }
        }

        stage('API Test') {
            steps {
                echo '=========================================='
                echo 'API Test'
                echo '=========================================='

                bat "\"%PYTHON%\" -m pytest 02_API_Automation\\tests\\ -s"
            }
        }

        stage('Playwright Test') {
            steps {
                echo '=========================================='
                echo 'Playwright UI Test'
                echo '=========================================='

                bat "\"%PYTHON%\" -m pytest 01_UI_Automation\\Playwright\\tests\\ -s"
            }
        }
    }

    post {

        always {
            echo '=========================================='
            echo 'Jenkins Pipeline Finished'
            echo '=========================================='
        }

        success {
            echo 'TEST RESULT : PASS'
        }

        failure {
            echo 'TEST RESULT : FAIL'
        }
    }
}

